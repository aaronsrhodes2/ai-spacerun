# Skippy Copilot settings. Copy this file to copilot.env (same folder) and fill in the three parts.
# Then run:   python -m copilot --check
# It goes through everything step by step and tells you in plain words what to fix.

# ---- 1. The game ---------------------------------------------------------------------------------------------------
# The bridge talks to the game over RCON, which the game only offers when it runs as a server or hosts multiplayer.
# Start Factorio with:   --rcon-port 27015 --rcon-password <a password you choose>
# and put the same port and password here.
COPILOT_RCON_HOST=127.0.0.1
COPILOT_RCON_PORT=27015
COPILOT_RCON_PASSWORD=

# ---- 2. The AI: one source, one key ----------------------------------------------------------------------------------
# Choose ONE and delete the others.

# (a) An AI service or a local server that speaks the OpenAI chat API (most do). You need its address, your key, and the
#     name of a model that can use tools.
COPILOT_SOURCE=openai
COPILOT_URL=
COPILOT_KEY=
COPILOT_MODEL=

# (a2) A server that speaks the Anthropic Messages API instead (Skippy Core's model does; so does Anthropic).
# COPILOT_SOURCE=anthropic
# COPILOT_URL=
# COPILOT_KEY=
# COPILOT_MODEL=

# (b) Ollama on this computer. No key. Pick a model you have pulled that can use tools.
# COPILOT_SOURCE=ollama
# COPILOT_MODEL=qwen3:8b

# (c) Purple Skippy (the SkippyTel project's agent), working in one workspace. The key is the bridge's token.
#     Purple is an agent built for long jobs: each turn takes minutes and it runs one at a time.
# COPILOT_SOURCE=purple
# COPILOT_URL=http://localhost:9337
# COPILOT_KEY_FILE=
# COPILOT_WORKSPACE=

# ---- 3. Nothing else is needed. --------------------------------------------------------------------------------------
